# Copia este archivo a .env y completa los valores (NO subas .env a git)
# Spotify (opcional: si lo dejas vacío, el portal funcionará pero Spotify Top BTS no)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Correo (por defecto: MailHog local via Docker)
# UI: http://localhost:8025
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=

# Opcionales (para controlar PHPMailer)
# SMTP_AUTH=0 (recomendado para MailHog)
SMTP_AUTH=0
# SMTP_SECURE: none|tls|ssl
SMTP_SECURE=none

# From (si SMTP_USERNAME está vacío)
MAIL_FROM=no-reply@btsecho.local

# Archivo: database/.env.example — Proposito: plantilla de variables de entorno para Docker (Spotify + correo).
# Copia este archivo a .env y completa los valores (NO subas .env a git)
# Spotify (opcional: si lo dejas vacio, el portal funcionara pero Spotify Top BTS no)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Auth (recomendado): secreto para firmar tokens Bearer (HMAC)
# Genera uno largo/aleatorio (no lo compartas publicamente)
BTSECHO_AUTH_SECRET=

# Correo (por defecto: MailHog local via Docker)
# UI: http://localhost:8025
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=

# URL base publica para construir el enlace del correo (reset-password)
# En local puedes dejarlo asi; en produccion cambialo a tu dominio.
APP_BASE_URL=http://localhost:8000

# Debug (0/1): si es 1, las APIs pueden devolver info extra en respuestas de error.
APP_DEBUG=0

# Opcionales (para controlar PHPMailer)
# SMTP_AUTH=0 (recomendado para MailHog)
SMTP_AUTH=0
# SMTP_SECURE: none|tls|ssl
SMTP_SECURE=none

# From (si SMTP_USERNAME esta vacio)
MAIL_FROM=no-reply@btsecho.local

# Spotify (opcional): ruta del cache server-side del token client_credentials
# Por defecto se usa sys_get_temp_dir() dentro del contenedor.
BTSECHO_SPOTIFY_TOKEN_CACHE=
